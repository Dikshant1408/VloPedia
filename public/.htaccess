# ----------------------------------------------------------------------
# VloPedia Apache Web Server Configuration (.htaccess)
# Designed for FreeHosting.com / Shared cPanel / DirectAdmin Hosting
# ----------------------------------------------------------------------

Options -Indexes +FollowSymLinks
DirectoryIndex index.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (prevents loops, supports proxy headers & Cloudflare)
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:CF-Visitor} !{"scheme":"https"}
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Security: Block hidden files & sensitive directories (.git, .env, etc.)
  RewriteRule "(^|/)\." - [F]

  # 3. Serve physical files directly (CSS, JS, images, fonts, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Clean URLs for Next.js SSG: Route /path to /path.html
  # Handles routes like /agents, /weapons/vandal, /skins/aemondir-vandal/watch
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 5. Trailing slash / directory index fallback
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 6. Fallback unmatched routes to 404 with genuine HTTP 404 status
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# Custom Error Document
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# Proper MIME Types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType text/plain .txt
</IfModule>

# ----------------------------------------------------------------------
# Performance & Caching
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Next.js immutable static build assets (hashed filenames in _next/static)
  <FilesMatch "\.(js|mjs|css|woff|woff2|png|jpg|jpeg|gif|webp|avif|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages - revalidate so updates are immediate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Standard Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
