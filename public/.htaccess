# ----------------------------------------------------------------------
# VloPedia Web Server Configuration (.htaccess)
# Production Ready for InfinityFree / Apache
# ----------------------------------------------------------------------

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS safely (only if explicitly forwarded as insecure HTTP)
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Security: Block hidden files & sensitive directories (.git, .env, etc.)
  RewriteRule "(^|/)\." - [F]

  # 3. Serve physical files directly (CSS, JS, images, fonts, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Route /section to /section.html even if directory /section/ exists!
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # 5. Serve directory index if index.html exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]
</IfModule>

# Custom Error Documents
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ----------------------------------------------------------------------
# Proper MIME Types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType text/plain .txt
</IfModule>

# ----------------------------------------------------------------------
# Performance & Caching
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # Next.js immutable static build assets
  <FilesMatch "\.(js|mjs|css|woff|woff2|png|jpg|jpeg|gif|webp|avif|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages - revalidate immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Standard Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
