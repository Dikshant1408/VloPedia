{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/agents/reyna-devour",
      "destination": "/agents/reyna",
      "permanent": true
    },
    {
      "source": "/agents/summit-map",
      "destination": "/maps",
      "permanent": true
    },
    {
      "source": "/agents/summit",
      "destination": "/maps",
      "permanent": true
    },
    {
      "source": "/agents/kay/o",
      "destination": "/agents/kay-o",
      "permanent": true
    },
    {
      "source": "/maps/skirmish%20a",
      "destination": "/maps",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
